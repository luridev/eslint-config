{
  "name": "@protoapps/eslint-config",
  "version": "0.3.5",
  "description": "Opinionated ESLint flat config for JavaScript, TypeScript, Node, and optional Vue, Vitest, and Playwright projects",
  "license": "MIT",
  "repository": "github:luridev/eslint-config",
  "homepage": "https://github.com/luridev/eslint-config#readme",
  "bugs": "https://github.com/luridev/eslint-config/issues",
  "author": "Anton V.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check:commit": "npm run lint && npm run typecheck && npm test",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "prepack": "npm run build",
    "prepublishOnly": "npm --dry-run=false run check:commit",
    "prerelease": "jiti scripts/checkRelease.ts",
    "release": "npm run check:commit && bumpp",
    "test": "npm run test:unit && npm run test:package",
    "test:package": "npm run build && jiti scripts/verifyPackage.ts",
    "test:unit": "npm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "eslint",
    "eslint-config",
    "typescript",
    "stylistic",
    "vue",
    "accessibility",
    "vitest",
    "playwright"
  ],
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-package-json": "^1.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript-eslint": "^8.63.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.0.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "bumpp": "^12.3.0",
    "changelogithub": "^15.0.5",
    "cross-spawn": "^7.0.6",
    "eslint": "^10.6.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-vue": "^10.9.2",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "lefthook": "^2.1.14",
    "publint": "^0.3.24",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "peerDependencies": {
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.4.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-vue": "^10.9.2",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "typescript": "^6.0.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "peerDependenciesMeta": {
    "@vitest/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-playwright": {
      "optional": true
    },
    "eslint-plugin-vue": {
      "optional": true
    },
    "eslint-plugin-vuejs-accessibility": {
      "optional": true
    },
    "vue-eslint-parser": {
      "optional": true
    }
  },
  "allowScripts": {
    "lefthook@2.1.14": true,
    "unrs-resolver": false
  }
}
